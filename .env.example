# StoneHead Discord bot — environment
# ===================================
# Copy to .env and fill in, OR set these as variables in your host's panel.
# Never commit the filled-in .env — .gitignore already excludes it.

# Bot token from https://discord.com/developers/applications → your app → Bot.
# Regenerate it immediately if it ever lands in a paste, a screenshot, or a
# commit — anyone holding it can run code as your bot.
DISCORD_TOKEN=

# Must match BOT_SHARED_SECRET in the StoneHead site's Netlify environment.
# Generate one long random string and paste the SAME value in both places:
#   openssl rand -hex 32
# A mismatch shows up as 401s in the bot log and "he's not answering right
# now" in Discord.
STONEHEAD_BOT_SECRET=

# Age gate. Defaults to ENABLED — the bot answers only in channels a server
# has flagged age-restricted, and in DMs. Setting this to 0 disables it.
#
# For local and staging testing ONLY. Never set it to 0 in a server that
# isn't yours: in someone else's server that flag is the only control you
# have over who is typing, and turning it off gives it away.
#
# Only the exact string "0" disables the gate. Blank, "false", "no" and
# anything else leave it on, so a typo can't quietly open it.
REQUIRE_AGE_RESTRICTED=1

# The lookup endpoint. The default is correct for production; override it to
# point at a Netlify deploy preview or a local `netlify dev`.
STONEHEAD_API=https://stoneheadai.com/api/strain-lookup
